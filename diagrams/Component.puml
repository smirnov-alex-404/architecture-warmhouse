@startuml

title WarmHouse Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(WarmHouseSystem, "WarmHouse System") {
  Container(WebApp, "Web Application", "Python, FastAPI", "Обрабатывает запросы")
  Container(Database, "Database", "PostgreSQL", "Хранит данные")
}

Container(WebApp, "Web Application", "Python, FastAPI") {
  Component(AuthController, "AuthController", "Отвечает за авторизацию и аутентификацию")
  Component(UserController, "UserController", "Управляет аккаунтами пользователей")
  Component(DeviceController, "DeviceController", "Управляет устройствами")

  Component(ServiceLayer, "Service Layer", "Бизнес-логика")
  Component(RepositoryLayer, "Repository Layer", "Data access logic")
}


Rel(AuthController,ServiceLayer,"Calls business logic")
Rel(UserController,ServiceLayer,"Calls business logic")
Rel(DeviceController,ServiceLayer,"Calls business logic")

Rel(ServiceLayer,RepositoryLayer,"Reads/Writes data")
Rel(RepositoryLayer,Database,"Reads/Writes user data")

@enduml
